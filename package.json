{
  "name": "reops-ui",
  "version": "1.0.0",
  "description": "UI for user import export, updating of properties and there status in a sales work flow",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run check && vite build",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply reops --local",
    "db:remote": "wrangler d1 migrations apply reops --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "jose": "^6.2.15",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/leaflet": "^1.9.22",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261102.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "workerd@1.20261102.1": true,
    "esbuild@0.28.2": true
  }
}
