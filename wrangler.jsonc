{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reops-ui",
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "reops",
    "database_id": "7a1cc07b-395b-4bf2-8331-ddcd740e183d",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://reops-ui.anthonyrvillar.workers.dev",
    "ACCESS_TEAM_DOMAIN": "anthonyvillar.cloudflareaccess.com",
    "ACCESS_AUD": "997b58952c9e2460e1ca50a4b39b5fc5bb979653b7982448c9e79b3fe71a8919"
  },
  "env": {
    "preview": {
      "vars": {
        "APP_ORIGIN": "https://reops-ui.anthonyrvillar.workers.dev",
        "ACCESS_TEAM_DOMAIN": "anthonyvillar.cloudflareaccess.com",
        "ACCESS_AUD": "997b58952c9e2460e1ca50a4b39b5fc5bb979653b7982448c9e79b3fe71a8919"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reops",
          "database_id": "7a1cc07b-395b-4bf2-8331-ddcd740e183d"
        }
      ]
    }
  }
}
