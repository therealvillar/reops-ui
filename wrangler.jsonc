{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reops-ui",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "reops",
    "database_id": "7a1cc07b-395b-4bf2-8331-ddcd740e183d",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://reops-ui.anthonyrvillar.workers.dev",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
